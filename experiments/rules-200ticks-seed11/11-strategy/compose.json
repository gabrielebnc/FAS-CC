{
  "services": {
    "kafka": {
      "image": "spotify/kafka",
      "environment": {
        "ADVERTISED_HOST": "kafka",
        "ADVERTISED_PORT": "9092"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import socket; socket.create_connection((\"localhost\",9092),2).close()"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 90
      }
    },
    "http-server": {
      "image": "fas-evaluation/api:68fd799f1db0b595b8031d714992654f1ec51cb220c241fa1c30150ab44ba639",
      "pull_policy": "never",
      "ports": [
        {
          "target": 8080,
          "host_ip": "127.0.0.1",
          "protocol": "tcp"
        }
      ],
      "depends_on": {
        "kafka": {
          "condition": "service_healthy"
        }
      },
      "entrypoint": [
        "python",
        "-c",
        "import aiokafka; assert aiokafka.__version__ == \"0.12.0\", \"Pin aiokafka==0.12.0 and rebuild the API image\"; import uvicorn; uvicorn.run(\"app.main:app\",host=\"0.0.0.0\",port=8080)"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen(\"http://localhost:8080/\",timeout=2)"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 60
      }
    },
    "crowdnav": {
      "image": "fas-evaluation/crowdnav:fe0635e97f54d083a7e1001f243bcaae922ee300234fa52122ca9b23f17464cd",
      "pull_policy": "never",
      "init": true,
      "depends_on": {
        "http-server": {
          "condition": "service_healthy"
        }
      },
      "working_dir": "/app",
      "entrypoint": [
        "python",
        "/evaluation_simulation.py"
      ],
      "environment": {
        "EVALUATION_SEED": "11",
        "PYTHONHASHSEED": "11",
        "PYTHONUNBUFFERED": "1"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/Users/gbianchi/uni/adapsw/UPISAS/experiments/rules-200ticks-seed11/evaluation_simulation.py",
          "target": "/evaluation_simulation.py",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "/Users/gbianchi/uni/adapsw/UPISAS/experiments/rules-200ticks-seed11/11-strategy",
          "target": "/results",
          "read_only": false
        },
        {
          "type": "bind",
          "source": "/Users/gbianchi/uni/adapsw/UPISAS/experiments/rules-200ticks-seed11/11-strategy/knobs.json",
          "target": "/app/knobs.json",
          "read_only": true
        }
      ]
    }
  }
}